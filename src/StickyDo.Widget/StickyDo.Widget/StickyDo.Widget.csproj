<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Required so the MSIX packaging project (StickyDo.Widget.Package) can restore and
         publish a win-x64 apphost; NuGet requires every project in the reference graph to
         restore the same RID once any project in the graph targets it. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../StickyDo.Widget.Controls/StickyDo.Widget.Controls.csproj"/>
    <ProjectReference Include="../../StickyDo.Domain/StickyDo.Domain.csproj"/>
  </ItemGroup>

  <ItemGroup>
    <!-- UseWindowsForms implicitly global-uses System.Windows.Forms/System.Drawing, which collide
         with WPF's System.Windows/System.Windows.Media types (Application, Brush, UserControl, ...).
         Only the tray icon code needs WinForms, so it opts in locally with its own using directive. -->
    <Using Remove="System.Windows.Forms"/>
    <Using Remove="System.Drawing"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2"/>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0"/>
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico"/>
    <Resource Include="Assets\app.png"/>
  </ItemGroup>

</Project>
