<Window x:Class="StickyDo.Widget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyDo.Widget"
        xmlns:controls="clr-namespace:StickyDo.Widget.Controls;assembly=StickyDo.Widget.Controls"
        xmlns:views="clr-namespace:StickyDo.Widget.Views"
        xmlns:converters="clr-namespace:StickyDo.Widget.Converters"
        mc:Ignorable="d"
        Title="StickyDo" Height="700" Width="1200"
        Icon="pack://application:,,,/Assets/app.png"
        Background="Transparent" ResizeMode="CanResizeWithGrip"
        WindowStyle="None" AllowsTransparency="True"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="True">

    <Border x:Name="RootBorder" Background="White">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="#D0D0D0"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="4"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="CornerRadius" Value="0"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="56"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Left Sidebar Navigation - extends to full height -->
            <controls:SidebarNavigation Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"/>

            <!-- Header Bar -->
            <Border x:Name="TitleBarBorder" Grid.Column="1" Grid.Row="0" Background="#F9F9F9" BorderBrush="#E8E8E8" BorderThickness="0,0,0,1">
                <Grid Margin="24,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Search Bar -->
                    <Border Grid.Column="0" Background="#F3F3F3" BorderBrush="#D8D8D8" BorderThickness="1"
                            Padding="12,8,12,8" VerticalAlignment="Center" Margin="0,0,16,0" MaxWidth="400" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Search Icon -->
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#999999"/>

                            <!-- Search TextBox -->
                            <TextBox Grid.Column="1" x:Name="SearchTextBox"
                                     FontSize="13"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="#666666"
                                     Text="{Binding NotesListViewModel.SearchQuery, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                            <!-- Search Placeholder (shown when query is empty; does not touch bound text) -->
                            <TextBlock Grid.Column="1" Text="Search tasks or notes..."
                                       FontSize="13" Foreground="#999999"
                                       VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding NotesListViewModel.SearchQuery}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <!-- Minimize Button -->
                    <Button Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Minimize"
                            Command="{Binding MinimizeWindowCommand}">
                        <TextBlock Text="−" FontSize="18" FontWeight="300" Foreground="#666666"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Maximize/Restore Button -->
                    <Button Grid.Column="2" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding MaximizeRestoreWindowCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="Maximize"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="ToolTip" Value="Restore"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="14" FontWeight="300" Foreground="#666666"
                                   VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="□"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                            <Setter Property="Text" Value="❐"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="3" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                            Cursor="Hand" ToolTip="Close"
                            Command="{Binding CloseWindowCommand}">
                        <TextBlock Text="✕" FontSize="16" FontWeight="400" Foreground="#666666"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Content Area: Notes List, or the Settings page when open -->
            <Border Grid.Column="1" Grid.Row="1" Background="#F9F9F9">
                <Grid>
                    <views:NotesListView DataContext="{Binding NotesListViewModel}">
                        <views:NotesListView.Style>
                            <Style TargetType="views:NotesListView">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:NotesListView.Style>
                    </views:NotesListView>

                    <views:SettingsView DataContext="{Binding Settings}">
                        <views:SettingsView.Style>
                            <Style TargetType="views:SettingsView">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding DataContext.IsSettingsOpen, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:SettingsView.Style>
                    </views:SettingsView>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
