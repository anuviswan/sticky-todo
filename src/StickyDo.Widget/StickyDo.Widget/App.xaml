<Application x:Class="StickyDo.Widget.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StickyDo.Widget"
             xmlns:converters="clr-namespace:StickyDo.Widget.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <converters:ColorArgbToBrushConverter x:Key="ColorArgbToBrushConverter"/>
            <converters:ColorNameConverter x:Key="ColorNameConverter"/>
            <converters:ColorToFooterColorConverter x:Key="ColorToFooterColorConverter"/>
            <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
            <converters:ColorEqualityToVisibilityConverter x:Key="ColorEqualityToVisibilityConverter"/>
            <converters:NoteSaveStateToIconConverter x:Key="NoteSaveStateToIconConverter"/>
            <converters:NoteSaveStateToTooltipConverter x:Key="NoteSaveStateToTooltipConverter"/>
            <converters:NoteSyncStateToIconConverter x:Key="NoteSyncStateToIconConverter"/>
            <converters:NoteSyncStateToTooltipConverter x:Key="NoteSyncStateToTooltipConverter"/>
            <converters:NoteSyncStateToPendingVisibilityConverter x:Key="NoteSyncStateToPendingVisibilityConverter"/>
            <converters:NoteTypeToVisibilityConverter x:Key="NoteTypeToVisibilityConverter"/>
            <converters:IsNotNullToBooleanConverter x:Key="IsNotNullToBooleanConverter"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
