<Window x:Class="StickyDo.Widget.Views.StickyNoteWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:StickyDo.Widget.Views"
        xmlns:controls="clr-namespace:StickyDo.Widget;assembly=StickyDo.Widget.Controls"
        xmlns:behaviors="clr-namespace:StickyDo.Widget.Behaviors"
        xmlns:richTextBehaviors="clr-namespace:StickyDo.Widget.Controls.Behaviors;assembly=StickyDo.Widget.Controls"
        xmlns:documents="clr-namespace:System.Windows.Documents;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="Sticky Note" Height="400" Width="320" MinHeight="200" MinWidth="250"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="False"
        behaviors:WindowBehavior.IsEnabled="True">

    <Grid>
    <Border Background="{Binding CurrentColor, Converter={StaticResource ColorArgbToBrushConverter}}" BorderBrush="#E8D4B8" BorderThickness="1" CornerRadius="8">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{Binding CurrentColor, Converter={StaticResource ColorArgbToBrushConverter}}"/>
                <Setter Property="BorderBrush" Value="#E8D4B8"/>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="40"/>
            </Grid.RowDefinitions>

            <!-- Title Bar -->
            <Border x:Name="TitleBarBorder" Grid.Row="0" Background="{Binding CurrentColor, Converter={StaticResource ColorArgbToBrushConverter}}" BorderBrush="#E8D4B8" BorderThickness="0,0,0,1" Padding="12,8,12,8"
                    CornerRadius="8,8,0,0"
                    Cursor="SizeAll"
                    behaviors:DragWindowBehavior.CanDrag="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Create New Note Button -->
                    <Button Grid.Column="0"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="Create new note"
                            Command="{Binding CreateNewNoteCommand}">
                        <TextBlock Text="+" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666666" FontWeight="Bold"/>
                    </Button>

                    <!-- Note Title (Editable) -->
                    <!-- Sized to content and left-aligned (not stretched) so the surrounding header
                         space stays part of the TitleBarBorder drag zone; only clicks on the
                         text itself land on the TextBox and enter edit mode. -->
                    <TextBox Grid.Column="1"
                             Text="{Binding Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             behaviors:CommitOnLostFocusBehavior.Command="{Binding SaveCommand}"
                             FontSize="14"
                             FontWeight="500"
                             Foreground="#333333"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="6,2"
                             HorizontalAlignment="Left"
                             VerticalAlignment="Center"
                             Cursor="IBeam">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Return" Command="{Binding SaveCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>

                    <!-- Favorite / Unfavorite Icon -->
                    <Button Grid.Column="2"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="12,0,4,0"
                            VerticalAlignment="Center"
                            Command="{Binding ToggleFavoriteCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="Mark as favorite"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                        <Setter Property="ToolTip" Value="Remove from favorites"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="☆"/>
                                    <Setter Property="Foreground" Value="#666666"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsFavorite}" Value="True">
                                            <Setter Property="Text" Value="★"/>
                                            <Setter Property="Foreground" Value="#F5A623"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Button>

                    <!-- Pin / Unpin Icon -->
                    <Button Grid.Column="3"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Command="{Binding TogglePinCommand}">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="ToolTip" Value="Pin"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                        <Setter Property="ToolTip" Value="Unpin"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Grid Width="20" Height="20">
                            <!-- Pinned indicator badge -->
                            <Border CornerRadius="10" Background="#FFD966">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="📌" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="-40"/>
                                </TextBlock.RenderTransform>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPinned}" Value="True">
                                                <Setter Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="0"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>

                    <!-- Close Button -->
                    <Button Grid.Column="4"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Command="{Binding CloseWindowCommand}"
                            IsEnabled="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"
                            VerticalAlignment="Center"
                            ToolTip="Close">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.35"/>
                                        <Setter Property="Cursor" Value="Arrow"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="×" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#666666" FontWeight="Bold"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Task List with Add Task (Todo type only) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="12,12,12,8"
                          Visibility="{Binding Type, Converter={StaticResource NoteTypeToVisibilityConverter}, ConverterParameter=Todo}">
                <StackPanel>
                    <!-- Existing Tasks -->
                    <ItemsControl ItemsSource="{Binding Tasks}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <controls:StickyNoteTaskItem Margin="0,0,0,8"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Add a task input area - appears as next line in task list -->
                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Plus Icon -->
                        <TextBlock Grid.Column="0"
                                   Text="+"
                                   FontSize="16"
                                   Foreground="#B8A080"
                                   Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   FontWeight="Bold"/>

                        <!-- Add Task Placeholder (shows when field is empty) -->
                        <TextBlock Grid.Column="1"
                                   Text="Add a task..."
                                   FontSize="13"
                                   Foreground="#000000"
                                   FontStyle="Italic"
                                   VerticalAlignment="Center"
                                   Cursor="IBeam">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding FocusAddTaskInputCommand}"/>
                            </TextBlock.InputBindings>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewTaskTitle}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding NewTaskTitle}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <!-- Add Task Input Field (overlaid on placeholder) -->
                        <TextBox Grid.Column="1"
                                 x:Name="AddTaskInput"
                                 Text="{Binding NewTaskTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 behaviors:FocusBehavior.IsFocused="{Binding ShouldFocusAddTaskInput, Mode=OneWay}"
                                 behaviors:CommitOnLostFocusBehavior.Command="{Binding AddTaskCommand}"
                                 FontSize="13"
                                 Foreground="#333333"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalAlignment="Center">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <!-- Add Button (visible when text is entered) -->
                        <Button Grid.Column="2"
                                Width="20"
                                Height="20"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                Padding="0"
                                VerticalAlignment="Center"
                                Margin="8,0,0,0"
                                Command="{Binding AddTaskCommand}"
                                ToolTip="Add task">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding NewTaskTitle}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <TextBlock Text="✓" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#B8A080" FontWeight="Bold"/>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <!-- Free-form Content (Note type only) -->
            <Grid Grid.Row="1"
                  Visibility="{Binding Type, Converter={StaticResource NoteTypeToVisibilityConverter}, ConverterParameter=Note}">
                <!-- Placeholder (shows when content is empty) -->
                <TextBlock Text="Start typing your note..."
                           FontSize="13"
                           Foreground="#000000"
                           FontStyle="Italic"
                           Margin="12,12,12,8"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Content}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Content}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <RichTextBox x:Name="ContentRichTextBox"
                             richTextBehaviors:RichTextEditorBehavior.PlainText="{Binding Content, Mode=TwoWay}"
                             richTextBehaviors:RichTextEditorBehavior.Formatting="{Binding ContentFormatting, Mode=TwoWay}"
                             FontSize="13"
                             Foreground="#333333"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="12,12,12,8"
                             AcceptsReturn="True"
                             AcceptsTab="False"
                             VerticalScrollBarVisibility="Auto"
                             Cursor="IBeam">
                    <RichTextBox.Resources>
                        <!-- Match the tight line spacing of the plain TextBox this replaces -
                             RichTextBox's default Paragraph margin would otherwise add visible
                             gaps between lines. -->
                        <Style TargetType="Paragraph">
                            <Setter Property="Margin" Value="0"/>
                        </Style>
                    </RichTextBox.Resources>
                </RichTextBox>
            </Grid>

            <!-- Status Bar -->
            <Border Grid.Row="2" Background="{Binding CurrentColor, Converter={StaticResource ColorToFooterColorConverter}}" BorderBrush="#E8D4B8" BorderThickness="0,1,0,0" Padding="12,6,12,6"
                    CornerRadius="0,0,8,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Grid.Resources>
                        <!-- Same hover shade as the rich text toolbar's checked-state background
                             (#4D000000, see the ToggleButton style above) - the default WPF Button
                             hover chrome read as too bright against the note's pastel background. -->
                        <Style x:Key="FooterIconButtonStyle" TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bg" Property="Background" Value="#4D000000"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Grid.Resources>

                    <!-- Save Status Icon: reflects whether the latest edits have been persisted.
                         Non-interactive (plain TextBlock, no Command) - informational only. -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SaveStatus, Converter={StaticResource NoteSaveStateToIconConverter}}"
                               ToolTip="{Binding SaveStatus, Converter={StaticResource NoteSaveStateToTooltipConverter}}"
                               FontSize="12"
                               Foreground="#999999"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"/>

                    <!-- Sync Status Icon: Phase 1 placeholder, always "Not Synced" until the sync
                         engine ships. A plain cloud glyph alone reads as "synced" (the common
                         OneDrive/Google Drive convention), so a small clock badge is overlaid
                         whenever the state is NotSynced, signaling "pending" rather than "done".
                         Bound through SyncStatus/the same converter pattern as Save Status so a
                         future release can swap in real sync state - including hiding the badge
                         once "Synced" exists - without touching this layout. Non-interactive -
                         informational only.

                         Sync feature is planned for a future release.
                         The icon is intentionally kept in the UI but hidden for now.
                         Re-enable visibility when synchronization support is implemented. -->
                    <Grid Grid.Column="1"
                          Width="20" Height="17"
                          Visibility="Collapsed"
                          ToolTip="{Binding SyncStatus, Converter={StaticResource NoteSyncStateToTooltipConverter}}">
                        <TextBlock Text="{Binding SyncStatus, Converter={StaticResource NoteSyncStateToIconConverter}}"
                                   FontSize="13"
                                   Foreground="#999999"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Top"/>
                        <Grid Width="11" Height="11"
                              HorizontalAlignment="Right"
                              VerticalAlignment="Bottom"
                              Visibility="{Binding SyncStatus, Converter={StaticResource NoteSyncStateToPendingVisibilityConverter}}">
                            <Ellipse Stroke="#999999"
                                     StrokeThickness="1"
                                     Fill="{Binding CurrentColor, Converter={StaticResource ColorToFooterColorConverter}}"/>
                            <Line X1="5.5" Y1="5.5" X2="5.5" Y2="2.5" Stroke="#999999" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Line X1="5.5" Y1="5.5" X2="7.5" Y2="5.5" Stroke="#999999" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Grid>
                    </Grid>

                    <!-- Rich Text Formatting Toolbar: acts on whichever content/task RichTextBox
                         last had focus in this window (see RichTextEditorBehavior.FocusedEditor),
                         the same way the Windows 11 Sticky Notes toolbar works - not tied to one
                         fixed control. Disabled (not hidden) until the user has focused an
                         editable text field, since it never applies to titles. The group itself
                         has no fill (a filled pill around all four icons made the whole group read
                         as "selected" even at rest) - only the actually-toggled-on button gets a
                         darker background, everything else stays flush with the footer. -->
                    <Border Grid.Column="3"
                            Margin="0"
                            Padding="2"
                            CornerRadius="4"
                            IsEnabled="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.FocusedEditor), Converter={StaticResource IsNotNullToBooleanConverter}}">
                        <StackPanel Orientation="Horizontal">
                            <StackPanel.Resources>
                                <Style TargetType="ToggleButton">
                                    <Setter Property="Width" Value="20"/>
                                    <Setter Property="Height" Value="18"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="3">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#14000000"/>
                                                    </Trigger>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Bg" Property="Background" Value="#4D000000"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>
                            <ToggleButton ToolTip="Bold"
                                          Command="{x:Static documents:EditingCommands.ToggleBold}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.FocusedEditor)}"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.IsBoldActive), Mode=OneWay}">
                                <TextBlock Text="B" FontSize="12" FontWeight="Bold"/>
                            </ToggleButton>
                            <ToggleButton ToolTip="Italic"
                                          Command="{x:Static documents:EditingCommands.ToggleItalic}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.FocusedEditor)}"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.IsItalicActive), Mode=OneWay}">
                                <TextBlock Text="I" FontSize="12" FontStyle="Italic"/>
                            </ToggleButton>
                            <ToggleButton ToolTip="Underline"
                                          Command="{x:Static documents:EditingCommands.ToggleUnderline}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.FocusedEditor)}"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.IsUnderlineActive), Mode=OneWay}">
                                <TextBlock Text="U" FontSize="12" TextDecorations="Underline"/>
                            </ToggleButton>
                            <ToggleButton ToolTip="Strikethrough"
                                          Command="{x:Static richTextBehaviors:RichTextEditingCommands.ToggleStrikethrough}"
                                          CommandTarget="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.FocusedEditor)}"
                                          IsChecked="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=(richTextBehaviors:RichTextEditorBehavior.IsStrikethroughActive), Mode=OneWay}">
                                <TextBlock Text="S" FontSize="12" TextDecorations="Strikethrough"/>
                            </ToggleButton>
                            <Border Width="1" Margin="2,3,0,3" Background="#26000000"/>
                        </StackPanel>
                    </Border>

                    <!-- Color Palette Icon -->
                    <Button x:Name="PaletteButton"
                            Grid.Column="4"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="8,0,8,0"
                            VerticalAlignment="Center"
                            ToolTip="Color palette"
                            Style="{StaticResource FooterIconButtonStyle}"
                            Command="{Binding OpenColorPickerCommand}">
                        <TextBlock Text="🎨" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Button>

                    <!-- Menu Icon -->
                    <Button x:Name="MenuButton"
                            Grid.Column="5"
                            Width="20"
                            Height="20"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            ToolTip="More options"
                            Style="{StaticResource FooterIconButtonStyle}"
                            Command="{Binding OpenMoreOptionsCommand}">
                        <TextBlock Text="⋯" FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="#000000"/>
                    </Button>
                </Grid>
            </Border>

            <!-- Color Picker Popup -->
            <!-- StaysOpen="True": dismissal is handled entirely by PopupDismissBehavior below.
                 WPF's own StaysOpen="False" auto-dismiss can swallow the first real mouse click
                 on the popup's own content (a well-known WPF quirk: it treats that click-down as
                 "outside" and closes the popup before the child button's Click, which fires on
                 mouse-up, ever runs), so it must stay disabled here. -->
            <Popup x:Name="ColorPickerPopup"
                   IsOpen="{Binding IsColorPickerOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=PaletteButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   StaysOpen="True"
                   HorizontalOffset="-174"
                   VerticalOffset="-6"
                   behaviors:PopupDismissBehavior.DismissCommand="{Binding CloseColorPickerCommand}"
                   behaviors:PopupDismissBehavior.ToggleButton="{Binding ElementName=PaletteButton}">
                <controls:ColorPalettePopup DataContext="{Binding}"/>
            </Popup>

            <!-- More Options Popup (see StaysOpen note above). PopupAnimation is bound rather
                 than hardcoded: DeleteNoteAsync forces it to None for the close that precedes
                 the delete confirmation dialog, to avoid racing the fade-out animation against
                 that modal (see DeleteNoteAsync). -->
            <Popup x:Name="MoreOptionsFlyout"
                   IsOpen="{Binding IsMoreOptionsOpen, Mode=TwoWay}"
                   PlacementTarget="{Binding ElementName=MenuButton}"
                   Placement="Top"
                   AllowsTransparency="True"
                   PopupAnimation="{Binding MoreOptionsPopupAnimation}"
                   StaysOpen="True"
                   HorizontalOffset="-156"
                   VerticalOffset="-6"
                   behaviors:PopupDismissBehavior.DismissCommand="{Binding CloseMoreOptionsCommand}"
                   behaviors:PopupDismissBehavior.ToggleButton="{Binding ElementName=MenuButton}">
                <local:MoreOptionsPopup DataContext="{Binding MoreOptionsPopupViewModel}"/>
            </Popup>
        </Grid>
    </Border>

    <!-- Resize handles: thin invisible strips along each edge and small squares at each corner,
         layered above the note content so a drag from within a few pixels of the window's border
         resizes it instead of moving/clicking through to the content underneath. Declared after
         the note content and edges are declared before corners, so hit-testing at a corner favors
         the (smaller, diagonal-cursor) corner handle over the edge strips it overlaps in the
         margin-reserved corner area. Disabled while the note is pinned, matching
         DragWindowBehavior.CanDrag on the title bar above. -->
    <Rectangle Fill="Transparent" Cursor="SizeNS"
               VerticalAlignment="Top" HorizontalAlignment="Stretch" Height="6" Margin="10,0,10,0"
               behaviors:ResizeWindowBehavior.Edge="Top"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeNS"
               VerticalAlignment="Bottom" HorizontalAlignment="Stretch" Height="6" Margin="10,0,10,0"
               behaviors:ResizeWindowBehavior.Edge="Bottom"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeWE"
               HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="6" Margin="0,10,0,10"
               behaviors:ResizeWindowBehavior.Edge="Left"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeWE"
               HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="6" Margin="0,10,0,10"
               behaviors:ResizeWindowBehavior.Edge="Right"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>

    <Rectangle Fill="Transparent" Cursor="SizeNWSE"
               HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10"
               behaviors:ResizeWindowBehavior.Edge="TopLeft"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeNESW"
               HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10"
               behaviors:ResizeWindowBehavior.Edge="TopRight"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeNESW"
               HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="10" Height="10"
               behaviors:ResizeWindowBehavior.Edge="BottomLeft"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    <Rectangle Fill="Transparent" Cursor="SizeNWSE"
               HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="10" Height="10"
               behaviors:ResizeWindowBehavior.Edge="BottomRight"
               behaviors:ResizeWindowBehavior.CanResize="{Binding IsPinned, Converter={StaticResource InverseBooleanConverter}}"/>
    </Grid>
</Window>
