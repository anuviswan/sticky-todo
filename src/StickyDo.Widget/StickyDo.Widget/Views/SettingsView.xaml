<UserControl x:Class="StickyDo.Widget.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:StickyDo.Widget.Resources"
             mc:Ignorable="d"
             Background="#F5F6F8">

    <UserControl.Resources>
        <!-- Rounded gray secondary button ("Check for updates") -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F3F4F6"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular note-color swatch button, same shape/behavior as ColorPalettePopup's swatches -->
        <Style x:Key="ColorSwatchButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{Binding ., Converter={StaticResource ColorArgbToBrushConverter}}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#14000000"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="13">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Plain icon-only close button, matching the × used elsewhere in the app (MainWindow, StickyNoteWindow) -->
        <Style x:Key="ClosePageButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E5E7EB"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="32,28,32,28">

            <!-- Header -->
            <Grid>
                <StackPanel HorizontalAlignment="Left">
                    <TextBlock Text="{x:Static res:Resources.Settings_Title}" FontSize="26" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="{x:Static res:Resources.Settings_Subtitle}" FontSize="13" Foreground="#6B7280" Margin="0,4,0,0"/>
                </StackPanel>

                <Button HorizontalAlignment="Right" VerticalAlignment="Top"
                        Style="{StaticResource ClosePageButtonStyle}"
                        Command="{Binding CloseCommand}"
                        ToolTip="Close Settings">
                    <TextBlock Text="✕" FontSize="16" Foreground="#666666"/>
                </Button>
            </Grid>

            <!-- GENERAL section -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,12">
                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                    <Canvas Width="16" Height="16">
                        <Line X1="1.5" Y1="4" X2="14.5" Y2="4" Stroke="#4F46E5" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                        <Ellipse Canvas.Left="8.5" Canvas.Top="2.2" Width="3.6" Height="3.6" Fill="#4F46E5"/>
                        <Line X1="1.5" Y1="8" X2="14.5" Y2="8" Stroke="#4F46E5" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                        <Ellipse Canvas.Left="4" Canvas.Top="6.2" Width="3.6" Height="3.6" Fill="#4F46E5"/>
                        <Line X1="1.5" Y1="12" X2="14.5" Y2="12" Stroke="#4F46E5" StrokeThickness="1.4" StrokeStartLineCap="Round"/>
                        <Ellipse Canvas.Left="10" Canvas.Top="10.2" Width="3.6" Height="3.6" Fill="#4F46E5"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{x:Static res:Resources.Settings_Section_General}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
            </StackPanel>

            <!-- Launch at startup -->
            <Border Style="{StaticResource SettingsCardStyle}" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource SettingsIconBadgeStyle}" Background="#DCEBFF" VerticalAlignment="Center">
                        <TextBlock Text="&#128640;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:Resources.Settings_LaunchAtStartup_Title}" Style="{StaticResource SettingsCardTitleTextStyle}"/>
                        <TextBlock Text="{x:Static res:Resources.Settings_LaunchAtStartup_Description}" Style="{StaticResource SettingsCardDescriptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <CheckBox Grid.Column="2" Style="{StaticResource ToggleSwitchStyle}"
                              IsChecked="{Binding LaunchAtStartup, Mode=TwoWay}"
                              VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Default note color -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBadgeStyle}" Background="#FDF1D6">
                            <TextBlock Text="&#127912;" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Resources.Settings_DefaultNoteColor_Title}" Style="{StaticResource SettingsCardTitleTextStyle}"/>
                            <TextBlock Text="{x:Static res:Resources.Settings_DefaultNoteColor_Description}" Style="{StaticResource SettingsCardDescriptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding AvailableColors}" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="34" Height="34" Margin="0,0,10,0">
                                    <Button Width="26" Height="26"
                                            Style="{StaticResource ColorSwatchButtonStyle}"
                                            Command="{Binding DataContext.SelectDefaultColorCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding .}"
                                            ToolTip="{Binding Converter={StaticResource ColorNameConverter}}"/>

                                    <Border BorderBrush="#2563EB" BorderThickness="2" CornerRadius="15"
                                            Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                        <Border.Visibility>
                                            <MultiBinding Converter="{StaticResource ColorEqualityToVisibilityConverter}">
                                                <Binding Path="."/>
                                                <Binding Path="DataContext.SelectedDefaultColor" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Border.Visibility>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- DATA MANAGEMENT section -->
            <StackPanel Orientation="Horizontal" Margin="0,28,0,12">
                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                    <Canvas Width="16" Height="16">
                        <Ellipse Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="4" Stroke="#4F46E5" StrokeThickness="1.3"/>
                        <Path Data="M1.5,3.5 L1.5,12.5 A6.5,2 0 0 0 14.5,12.5 L14.5,3.5" Stroke="#4F46E5" StrokeThickness="1.3"/>
                        <Path Data="M1.5,8 A6.5,2 0 0 0 14.5,8" Stroke="#4F46E5" StrokeThickness="1.1"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Text="{x:Static res:Resources.Settings_Section_DataManagement}" Style="{StaticResource SettingsSectionHeaderTextStyle}"/>
            </StackPanel>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Import notes -->
                <Border Grid.Column="0" Style="{StaticResource SettingsCardStyle}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ImportNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBadgeStyle}" Background="#FDEBD3" VerticalAlignment="Top">
                            <TextBlock Text="&#11014;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Resources.Settings_ImportNotes_Title}" Style="{StaticResource SettingsCardTitleTextStyle}"/>
                            <TextBlock Text="{x:Static res:Resources.Settings_ImportNotes_Description}" Style="{StaticResource SettingsCardDescriptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="&#8250;" FontSize="18" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Export notes -->
                <Border Grid.Column="2" Style="{StaticResource SettingsCardStyle}" Cursor="Hand">
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick"
                                      Command="{Binding DataContext.ExportNotesCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                    </Border.InputBindings>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource SettingsIconBadgeStyle}" Background="#DDF3E4" VerticalAlignment="Top">
                            <TextBlock Text="&#11015;" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                            <TextBlock Text="{x:Static res:Resources.Settings_ExportNotes_Title}" Style="{StaticResource SettingsCardTitleTextStyle}"/>
                            <TextBlock Text="{x:Static res:Resources.Settings_ExportNotes_Description}" Style="{StaticResource SettingsCardDescriptionTextStyle}" Margin="0,2,0,0"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" Text="&#8250;" FontSize="18" Foreground="#9CA3AF" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- Application information -->
            <Border Style="{StaticResource SettingsCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Background="#0066CC" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="14" RadiusX="1.5" RadiusY="1.5"
                                           Stroke="White" StrokeThickness="1.3"/>
                                <Line X1="4.5" Y1="5.5" X2="11.5" Y2="5.5" Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4.5" Y1="8.5" X2="11.5" Y2="8.5" Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="4.5" Y1="11.5" X2="9" Y2="11.5" Stroke="White" StrokeThickness="1.2"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Border>

                    <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ApplicationName}" Style="{StaticResource SettingsCardTitleTextStyle}"/>
                        <TextBlock Text="{Binding ApplicationVersion}" Style="{StaticResource SettingsCardDescriptionTextStyle}" Margin="0,2,0,0"/>
                    </StackPanel>

                    <Button Grid.Column="2" Content="{x:Static res:Resources.Settings_CheckForUpdates}"
                            Style="{StaticResource SecondaryButtonStyle}" VerticalAlignment="Center"
                            Command="{Binding CheckForUpdatesCommand}"
                            IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InverseBooleanConverter}}"/>
                </Grid>
            </Border>

            <!-- Footer -->
            <Border BorderBrush="#E5E7EB" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,20,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{Binding CopyrightText}" FontSize="12" Foreground="#9CA3AF" VerticalAlignment="Center"/>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="{x:Static res:Resources.Settings_PrivacyPolicy}" FontSize="12" Foreground="#6B7280" Cursor="Hand" Margin="0,0,20,0">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenPrivacyPolicyCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                        <TextBlock Text="{x:Static res:Resources.Settings_TermsOfService}" FontSize="12" Foreground="#6B7280" Cursor="Hand">
                            <TextBlock.InputBindings>
                                <MouseBinding MouseAction="LeftClick" Command="{Binding OpenTermsOfServiceCommand}"/>
                            </TextBlock.InputBindings>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
