<UserControl x:Class="StickyDo.Widget.Views.NotesListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:local="clr-namespace:StickyDo.Widget.Controls;assembly=StickyDo.Widget.Controls"
             xmlns:conv="clr-namespace:StickyDo.Widget.Controls;assembly=StickyDo.Widget.Controls"
             mc:Ignorable="d"
             Background="#F9F9F9">
    <UserControl.Resources>
        <conv:CollectionToVisibilityConverter x:Key="CollectionToVisibilityConverter"/>
    </UserControl.Resources>
    <Grid x:Name="ContentGrid">
        <!-- Notes Board: notes grouped into color-based columns -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#F9F9F9"
                      x:Name="NotesScrollViewer"
                      Visibility="{Binding Columns, Mode=OneWay, Converter={StaticResource CollectionToVisibilityConverter}}">
            <StackPanel Orientation="Horizontal" Margin="24,16,24,16">
                <ItemsControl x:Name="ColumnsItemsControl"
                              ItemsSource="{Binding Columns, Mode=OneWay}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Width="220" Margin="0,0,20,0">
                                <ItemsControl ItemsSource="{Binding Notes, Mode=OneWay}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <local:StickyNoteListItem
                                                NoteId="{Binding Id, Mode=OneWay}"
                                                Title="{Binding Title, Mode=OneWay}"
                                                HasTasks="{Binding HasTasks, Mode=OneWay}"
                                                IsFavorite="{Binding IsFavorite, Mode=OneWay}"
                                                FirstTaskTitle="{Binding FirstTaskTitle, Mode=OneWay}"
                                                FirstTaskCompleted="{Binding FirstTaskCompleted, Mode=OneWay}"
                                                RemainingTaskCount="{Binding RemainingTaskCount, Mode=OneWay}"
                                                ColorBrush="{Binding ColorArgb, Mode=OneWay, Converter={StaticResource ColorArgbToBrushConverter}}"
                                                ToggleFavoriteCommand="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="StickyNoteListItem_MouseLeftButtonDown"
                                                PreviewMouseLeftButtonDown="StickyNoteListItem_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="StickyNoteListItem_PreviewMouseMove"
                                                Margin="0,0,0,12"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Create New Note tile -->
                <Button Command="{Binding CreateNoteCommand}" Cursor="Hand"
                        Width="220" Height="90" VerticalAlignment="Top"
                        Background="Transparent" BorderThickness="0" Padding="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Rectangle Stroke="#B0B0B0" StrokeThickness="1.5" StrokeDashArray="4 3"
                                           RadiusX="10" RadiusY="10" Fill="Transparent"/>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="&#128221;" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Create New Note" FontSize="12" Foreground="#666666" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Empty State -->
        <StackPanel x:Name="EmptyStatePanel" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Visibility="{Binding Columns, Mode=OneWay, Converter={StaticResource CollectionToVisibilityConverter}, ConverterParameter=inverted}"
                    Background="#F9F9F9">

            <!-- All Notes empty state -->
            <StackPanel x:Name="AllNotesEmptyState">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📋" FontSize="64" Foreground="#D0D0D0"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No notes yet" FontSize="18" FontWeight="500" Foreground="#666666"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Start by creating your first sticky note to stay organized."
                           FontSize="13" Foreground="#999999" HorizontalAlignment="Center"
                           Margin="0,0,0,24" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap"/>
                <Button Content="+ Create New Note" Padding="24,12,24,12"
                        FontSize="13" FontWeight="500"
                        Background="#0066CC" Foreground="White"
                        BorderThickness="0" Cursor="Hand"
                        Command="{Binding CreateNoteCommand}" HorizontalAlignment="Center"/>
            </StackPanel>

            <!-- Favorites empty state -->
            <StackPanel x:Name="FavoritesEmptyState">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ShowFavoritesOnly}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="☆" FontSize="64" Foreground="#D0D0D0"
                           HorizontalAlignment="Center" Margin="0,0,0,16"/>
                <TextBlock Text="No favorite notes yet" FontSize="18" FontWeight="500" Foreground="#666666"
                           HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock Text="Mark a note as favorite by clicking its star icon to have it appear here."
                           FontSize="13" Foreground="#999999" HorizontalAlignment="Center"
                           Margin="0,0,0,24" MaxWidth="400" TextAlignment="Center" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
