<UserControl x:Class="StickyDo.Widget.Views.MoreOptionsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:res="clr-namespace:StickyDo.Widget.Resources"
             mc:Ignorable="d"
             d:DesignHeight="120"
             d:DesignWidth="190"
             Background="Transparent">

    <UserControl.Resources>
        <SolidColorBrush x:Key="MenuIconBrush" Color="#555555"/>

        <Style x:Key="MenuItemButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
        <!-- White Menu Container with Drop Shadow -->
        <Border Background="White" CornerRadius="10" Padding="6" MinWidth="176">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <!-- Notes List -->
                <Button Style="{StaticResource MenuItemButtonStyle}"
                        ToolTip="{x:Static res:Resources.MoreOptionsPopup_NotesList}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="13" Height="13" RadiusX="2" RadiusY="2" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.3"/>
                                <Line X1="5.5" Y1="1.5" X2="5.5" Y2="14.5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.2"/>
                                <Line X1="7.5" Y1="5" X2="12" Y2="5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="7.5" Y1="8" X2="12" Y2="8" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="7.5" Y1="11" X2="12" Y2="11" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{x:Static res:Resources.MoreOptionsPopup_NotesList}" FontSize="13.5" Foreground="#333333" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Delete Note -->
                <Button Style="{StaticResource MenuItemButtonStyle}"
                        Margin="0,6,0,0"
                        ToolTip="{x:Static res:Resources.MoreOptionsPopup_DeleteNote}"
                        Command="{Binding DeleteNoteCommand}">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center">
                            <Canvas Width="16" Height="16">
                                <Rectangle Canvas.Left="6" Canvas.Top="2" Width="4" Height="2.5" RadiusX="1" RadiusY="1" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.2"/>
                                <Line X1="3" Y1="4.5" X2="13" Y2="4.5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Rectangle Canvas.Left="4" Canvas.Top="4.5" Width="8" Height="9" RadiusX="1.5" RadiusY="1.5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1.3"/>
                                <Line X1="6.5" Y1="6.5" X2="6.5" Y2="11.5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Line X1="9.5" Y1="6.5" X2="9.5" Y2="11.5" Stroke="{StaticResource MenuIconBrush}" StrokeThickness="1" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{x:Static res:Resources.MoreOptionsPopup_DeleteNote}" FontSize="13.5" Foreground="#333333" Margin="12,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
