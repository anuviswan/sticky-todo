<UserControl x:Class="StickyDo.Widget.Controls.StickyNoteListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StickyDo.Widget.Controls"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="220"
             Background="Transparent"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
    </UserControl.Resources>

    <Border Background="{Binding ColorBrush, Mode=OneWay, ElementName=Root}" CornerRadius="10"
            BorderBrush="#14000000" BorderThickness="1" Padding="14,12,14,10">
        <StackPanel>
            <!-- Title -->
            <TextBlock Text="{Binding Title, Mode=OneWay, ElementName=Root}"
                       FontWeight="700" FontSize="14" Foreground="#1F1F1F"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,10"/>

            <!-- First task (checkbox + text), shown only when the note has tasks -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasTasks, Mode=OneWay, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <CheckBox IsChecked="{Binding FirstTaskCompleted, Mode=OneWay, ElementName=Root}"
                          IsHitTestVisible="False" VerticalAlignment="Top" Margin="0,1,8,0"/>
                <TextBlock Text="{Binding FirstTaskTitle, Mode=OneWay, ElementName=Root}"
                           FontSize="12" Foreground="#333333"
                           TextWrapping="Wrap" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FirstTaskCompleted, ElementName=Root}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="#777777"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- "+N more" indicator when the note has additional tasks -->
            <TextBlock Text="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, StringFormat=+{0} more}"
                       FontSize="11" Foreground="#5C5C5C" Margin="24,4,0,0"
                       Visibility="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, Converter={StaticResource CountToVisibilityConverter}}"/>

            <!-- Static affordance glyph (no behavior wired up) -->
            <TextBlock Text="&#9662;" FontSize="12" Foreground="#66000000"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
