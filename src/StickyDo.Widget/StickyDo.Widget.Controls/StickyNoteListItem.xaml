<UserControl x:Class="StickyDo.Widget.Controls.StickyNoteListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StickyDo.Widget.Controls"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="220"
             Background="Transparent"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>

        <!-- Flat, read-only checkbox matching the note card task preview (checked = filled accent + white check) -->
        <Style x:Key="TaskPreviewCheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Width" Value="18"/>
            <Setter Property="Height" Value="18"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="Box" Width="18" Height="18" CornerRadius="4"
                                BorderThickness="2" BorderBrush="#0078D4" Background="White">
                            <Path x:Name="CheckMark" Data="M 3,9 L 7,13 L 15,4"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="#0078D4"/>
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{Binding ColorBrush, Mode=OneWay, ElementName=Root}" CornerRadius="4"
            BorderBrush="#14000000" BorderThickness="1" Padding="14,12,14,12">
        <StackPanel>
            <!-- Title -->
            <TextBlock Text="{Binding Title, Mode=OneWay, ElementName=Root}"
                       FontWeight="700" FontSize="14" Foreground="#3A4550"
                       TextTrimming="CharacterEllipsis" Margin="0,0,0,14"/>

            <!-- First task (checkbox + text), shown only when the note has tasks -->
            <StackPanel Orientation="Horizontal"
                        Visibility="{Binding HasTasks, Mode=OneWay, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <CheckBox Style="{StaticResource TaskPreviewCheckBoxStyle}"
                          IsChecked="{Binding FirstTaskCompleted, Mode=OneWay, ElementName=Root}"
                          VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Text="{Binding FirstTaskTitle, Mode=OneWay, ElementName=Root}"
                           FontSize="14" Foreground="#333333"
                           TextWrapping="Wrap" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FirstTaskCompleted, ElementName=Root}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="#8A8A8A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Expand indicator: always shown for a consistent card footer; the "+N more"
                 label only appears when the note has additional tasks beyond the first. -->
            <Border Width="72" Height="22" CornerRadius="11" Background="#14000000"
                    HorizontalAlignment="Center" Margin="0,14,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, StringFormat=+{0} more}"
                               FontSize="11" Foreground="#5C5C5C" Margin="0,0,4,0"
                               Visibility="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, Converter={StaticResource CountToVisibilityConverter}}"/>
                    <TextBlock Text="&#9662;" FontSize="13" Foreground="#5C5C5C"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
