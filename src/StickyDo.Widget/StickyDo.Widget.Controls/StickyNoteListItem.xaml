<UserControl x:Class="StickyDo.Widget.Controls.StickyNoteListItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:StickyDo.Widget.Controls"
             xmlns:converters="clr-namespace:StickyDo.Widget.Controls.Converters"
             mc:Ignorable="d"
             d:DesignHeight="100" d:DesignWidth="220"
             Background="Transparent"
             x:Name="Root">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:CountToVisibilityConverter x:Key="CountToVisibilityConverter"/>
        <converters:EnumNameEqualsConverter x:Key="EnumNameEqualsConverter"/>
    </UserControl.Resources>

    <Border Background="{Binding ColorBrush, Mode=OneWay, ElementName=Root}" CornerRadius="8"
            BorderBrush="#14000000" BorderThickness="1" Padding="14,12,14,12">
        <StackPanel>
            <!-- Title row: type icon, title text, then favorite toggle -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Note type icon: matches the sidebar's Todo (checklist) / Note (page + pencil) icons -->
                <Grid Grid.Column="0" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Viewbox Width="16" Height="16" ToolTip="Todo" AutomationProperties.Name="Todo item">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="Type" ElementName="Root" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Todo"/>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="1.5" Canvas.Top="1.8" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                       Stroke="#333333" StrokeThickness="1.2"/>
                            <Polyline Points="2.1,3.4 2.9,4.2 4.3,2.4" Stroke="#0066CC" StrokeThickness="0.9"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            <Line X1="6.6" Y1="3.5" X2="14.5" Y2="3.5" Stroke="#333333" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="1.5" Canvas.Top="6.3" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                       Stroke="#333333" StrokeThickness="1.2"/>
                            <Line X1="6.6" Y1="8" X2="14.5" Y2="8" Stroke="#333333" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            <Rectangle Canvas.Left="1.5" Canvas.Top="10.8" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                       Stroke="#333333" StrokeThickness="1.2"/>
                            <Line X1="6.6" Y1="12.5" X2="13" Y2="12.5" Stroke="#333333" StrokeThickness="1.3"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        </Canvas>
                    </Viewbox>

                    <Viewbox Width="16" Height="16" ToolTip="Note" AutomationProperties.Name="Note item">
                        <Viewbox.Style>
                            <Style TargetType="Viewbox">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="Type" ElementName="Root" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Note"/>
                                        </DataTrigger.Binding>
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Viewbox.Style>
                        <Canvas Width="16" Height="16">
                            <Rectangle Canvas.Left="1.5" Canvas.Top="1" Width="9.5" Height="12" RadiusX="1.3" RadiusY="1.3"
                                       Stroke="#333333" StrokeThickness="1.2"/>
                            <Line X1="3.5" Y1="4.5" X2="7.5" Y2="4.5" Stroke="#333333" StrokeThickness="0.9"/>
                            <Line X1="3.5" Y1="6.8" X2="7.5" Y2="6.8" Stroke="#333333" StrokeThickness="0.9"/>
                            <Line X1="3.5" Y1="9.1" X2="6" Y2="9.1" Stroke="#333333" StrokeThickness="0.9"/>
                            <Polygon Points="13.7,6.3 9.7,11.2 9.0,13.5 11.2,12.5 15.3,7.6" Stroke="#333333" StrokeThickness="1.1"
                                      StrokeLineJoin="Round"/>
                            <Line X1="12.7" Y1="7.6" X2="14.2" Y2="8.9" Stroke="#333333" StrokeThickness="0.9"/>
                        </Canvas>
                    </Viewbox>
                </Grid>

                <TextBlock Grid.Column="1"
                           Text="{Binding Title, Mode=OneWay, ElementName=Root}"
                           FontWeight="700" FontSize="14" Foreground="#3A4550"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                <Button Grid.Column="2"
                        Width="20" Height="20"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleFavoriteCommand, ElementName=Root}"
                        CommandParameter="{Binding NoteId, ElementName=Root}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="ToolTip" Value="Mark as favorite"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFavorite, ElementName=Root}" Value="True">
                                    <Setter Property="ToolTip" Value="Remove from favorites"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <TextBlock FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="☆"/>
                                <Setter Property="Foreground" Value="#666666"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFavorite, ElementName=Root}" Value="True">
                                        <Setter Property="Text" Value="★"/>
                                        <Setter Property="Foreground" Value="#F5A623"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Button>
            </Grid>

            <!-- First task (checkbox + text), shown only when the note has tasks.
                 Uses a Grid (not a horizontal StackPanel) so the text column has a bounded
                 width - a StackPanel gives its children unconstrained width along the stacking
                 axis, which silently defeats TextWrapping="Wrap" and lets long text render past
                 the card's edge instead of wrapping/truncating. -->
            <Grid Visibility="{Binding HasTasks, Mode=OneWay, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Shared checkbox style (Resources/Styles.xaml) so this matches the floating note editor's -->
                <CheckBox Grid.Column="0"
                          Style="{StaticResource TaskCheckBoxStyle}"
                          IsChecked="{Binding FirstTaskCompleted, Mode=OneWay, ElementName=Root}"
                          IsHitTestVisible="False" Focusable="False" FocusVisualStyle="{x:Null}"
                          VerticalAlignment="Top" Margin="0,2,10,0"/>
                <TextBlock Grid.Column="1"
                           Text="{Binding FirstTaskTitle, Mode=OneWay, ElementName=Root}"
                           FontSize="14" Foreground="#333333"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FirstTaskCompleted, ElementName=Root}" Value="True">
                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                    <Setter Property="Foreground" Value="#8A8A8A"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Free-form content preview, shown only for Note-type items with content -->
            <TextBlock Text="{Binding ContentPreview, Mode=OneWay, ElementName=Root}"
                       FontSize="14" Foreground="#333333"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Top">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ContentPreview, ElementName=Root}" Value="">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Expand indicator: always shown for a consistent card footer; the "+N more" text
                 is Hidden (not Collapsed) when there's nothing extra, so it still reserves its
                 layout space - the pill is exactly the same size whether or not the label is
                 actually visible, and the chevron in the Auto column stays pinned to the
                 trailing edge either way. -->
            <Border MinHeight="22" CornerRadius="11" Background="#14000000"
                    Padding="14,4,10,4" HorizontalAlignment="Center" Margin="0,14,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, StringFormat=+{0} more}"
                               FontSize="11" Foreground="#5C5C5C" Margin="0,0,6,0"
                               HorizontalAlignment="Left" VerticalAlignment="Center"
                               Visibility="{Binding RemainingTaskCount, Mode=OneWay, ElementName=Root, Converter={StaticResource CountToVisibilityConverter}}"/>
                    <Path Grid.Column="1" Data="M 0,0 L 5,5 L 10,0" Stroke="#5C5C5C" StrokeThickness="1.6"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="10" Height="6" Stretch="Uniform" VerticalAlignment="Center"/>
                </Grid>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
