<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required so the MSIX packaging project (StickyDo.Widget.Package) can restore this
         project for win-x64; NuGet requires every project in the reference graph to restore
         the same RID once any project in the graph targets it. -->
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <!-- Needed for RichTextFormatting/RichTextSpan (see RichText/RichTextDocumentConverter.cs):
         the rich-text editing behavior is shared between the Note content editor (StickyDo.Widget)
         and the Todo task row editor (this project), so it lives here, the common project both
         already depend on. -->
    <ProjectReference Include="../../StickyDo.Domain/StickyDo.Domain.csproj"/>
  </ItemGroup>

</Project>
