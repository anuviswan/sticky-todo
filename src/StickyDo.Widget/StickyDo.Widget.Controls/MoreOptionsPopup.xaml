<UserControl x:Class="StickyDo.Widget.MoreOptionsPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="100"
             d:DesignWidth="180"
             Background="Transparent">

    <StackPanel Orientation="Vertical" HorizontalAlignment="Right">
        <!-- White Menu Container with Drop Shadow -->
        <Border Background="White" CornerRadius="8" Padding="4">
            <Border.Effect>
                <DropShadowEffect BlurRadius="6" ShadowDepth="2" Opacity="0.15" Direction="270"/>
            </Border.Effect>
            <StackPanel Orientation="Vertical">
                <!-- Notes List -->
                <Button Cursor="Hand"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Notes List">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F2F2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#9638;" FontSize="14" Foreground="#333333" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Notes List" FontSize="13" Foreground="#333333" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- Delete Note -->
                <Button Cursor="Hand"
                        HorizontalContentAlignment="Left"
                        Padding="10,8"
                        Background="Transparent"
                        BorderThickness="0"
                        ToolTip="Delete Note"
                        Command="{Binding DeleteNoteCommand}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="6">
                                <ContentPresenter/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F2F2F2"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#128465;" FontSize="14" Foreground="#333333" Width="20" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Text="Delete Note" FontSize="13" Foreground="#333333" Margin="10,0,4,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
