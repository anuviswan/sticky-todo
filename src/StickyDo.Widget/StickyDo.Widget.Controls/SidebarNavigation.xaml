<UserControl x:Class="StickyDo.Widget.Controls.SidebarNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:StickyDo.Widget.Controls.Converters"
             mc:Ignorable="d"
             Width="64"
             Background="#F5F5F5"
             BorderBrush="#E8E8E8"
             BorderThickness="0,0,1,0">
    <UserControl.Resources>
        <converters:EnumNameEqualsConverter x:Key="EnumNameEqualsConverter"/>

        <!-- Square icon-only nav button: transparent by default, pale-yellow on hover. -->
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDE4C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllNotesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="AllNotes"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoritesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Favorites"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TrashNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Trash"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand mark -->
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,16,0,26">
            <Border Width="32" Height="32" CornerRadius="8" Background="#0066CC">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="White" StrokeThickness="1.3"/>
                        <Line X1="4.5" Y1="5.5" X2="11.5" Y2="5.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="8.5" X2="11.5" Y2="8.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="11.5" X2="9" Y2="11.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="STICKYDO" FontSize="8" FontWeight="700" Foreground="#0066CC"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Navigation Icons -->
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button x:Name="AllNotesNavButton" Style="{StaticResource AllNotesNavButtonStyle}"
                    Command="{Binding ShowAllNotesCommand}" ToolTip="All Notes" Margin="0,0,0,10">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="#333333" StrokeThickness="1.3"/>
                        <Line X1="4.5" Y1="5.5" X2="11.5" Y2="5.5" Stroke="#333333" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="8.5" X2="11.5" Y2="8.5" Stroke="#333333" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="11.5" X2="9" Y2="11.5" Stroke="#333333" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="FavoritesNavButton" Style="{StaticResource FavoritesNavButtonStyle}"
                    Command="{Binding ShowFavoritesCommand}" ToolTip="Favorites" Margin="0,0,0,10">
                <TextBlock Text="⭐" FontSize="30"/>
            </Button>

            <Button x:Name="TrashNavButton" Style="{StaticResource TrashNavButtonStyle}"
                    Command="{Binding ShowTrashCommand}" ToolTip="Trash">
                <Viewbox Width="18" Height="18">
                    <Canvas Width="16" Height="16">
                        <Line X1="6.5" Y1="2" X2="6.5" Y2="4" Stroke="#333333" StrokeThickness="1.1"/>
                        <Line X1="9.5" Y1="2" X2="9.5" Y2="4" Stroke="#333333" StrokeThickness="1.1"/>
                        <Line X1="6.5" Y1="2" X2="9.5" Y2="2" Stroke="#333333" StrokeThickness="1.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="3" Y1="4" X2="13" Y2="4" Stroke="#333333" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Polygon Points="4,4 12,4 11,14 5,14" Stroke="#333333" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        <Line X1="7" Y1="6.5" X2="7" Y2="11.5" Stroke="#333333" StrokeThickness="1"/>
                        <Line X1="9" Y1="6.5" X2="9" Y2="11.5" Stroke="#333333" StrokeThickness="1"/>
                    </Canvas>
                </Viewbox>
            </Button>
        </StackPanel>

        <!-- Settings, pinned to the bottom -->
        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Button x:Name="SettingsNavButton" Style="{StaticResource SidebarIconButtonStyle}" ToolTip="Settings">
                <TextBlock Text="⚙️" FontSize="16"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
