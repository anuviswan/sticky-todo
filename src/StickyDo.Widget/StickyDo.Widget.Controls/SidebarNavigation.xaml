<UserControl x:Class="StickyDo.Widget.Controls.SidebarNavigation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:StickyDo.Widget.Controls.Converters"
             xmlns:behaviors="clr-namespace:StickyDo.Widget.Controls.Behaviors"
             mc:Ignorable="d"
             Width="64"
             Background="#F3F3F3"
             BorderBrush="#E8E8E8"
             BorderThickness="0,0,1,0">
    <UserControl.Resources>
        <converters:EnumNameEqualsConverter x:Key="EnumNameEqualsConverter"/>

        <!-- Square icon-only nav button: transparent by default, pale-yellow on hover. -->
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#EDE4C0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="AllNotesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="AllNotes"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TodosNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Todos"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NotesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Notes"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="FavoritesNavButtonStyle" TargetType="Button" BasedOn="{StaticResource SidebarIconButtonStyle}">
            <Style.Triggers>
                <DataTrigger Value="True">
                    <DataTrigger.Binding>
                        <Binding Path="SelectedNavView" Converter="{StaticResource EnumNameEqualsConverter}" ConverterParameter="Favorites"/>
                    </DataTrigger.Binding>
                    <Setter Property="Background" Value="#EDE4C0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Trash is a plain drop target, not a nav button: it isn't clickable and doesn't
             navigate anywhere, so it's a dashed Rectangle rather than a Button. The Rectangle
             itself (not some wrapping panel) carries the drag-and-drop attached properties, so
             its Fill can react directly to the IsDragOver trigger below. -->
        <Style x:Key="TrashDropTargetStyle" TargetType="Rectangle">
            <Setter Property="Stroke" Value="#B0B0B0"/>
            <Setter Property="StrokeThickness" Value="1.3"/>
            <Setter Property="StrokeDashArray" Value="3 2"/>
            <Setter Property="RadiusX" Value="8"/>
            <Setter Property="RadiusY" Value="8"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="behaviors:DragDropTargetBehavior.IsDragOver" Value="True">
                    <Setter Property="Fill" Value="#F8D7D7"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Brand mark -->
        <StackPanel Grid.Row="0" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,16,0,26">
            <Border Width="32" Height="32" CornerRadius="8" Background="#0066CC">
                <Viewbox Width="16" Height="16">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="2" Canvas.Top="1" Width="12" Height="14" RadiusX="1.5" RadiusY="1.5"
                                   Stroke="White" StrokeThickness="1.3"/>
                        <Line X1="4.5" Y1="5.5" X2="11.5" Y2="5.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="8.5" X2="11.5" Y2="8.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="4.5" Y1="11.5" X2="9" Y2="11.5" Stroke="White" StrokeThickness="1.2"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Border>
            <TextBlock Text="STICKYDO" FontSize="8" FontWeight="700" Foreground="#0066CC"
                       HorizontalAlignment="Center" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Navigation Icons -->
        <StackPanel Grid.Row="1" Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Button x:Name="AllNotesNavButton" Style="{StaticResource AllNotesNavButtonStyle}"
                    Command="{Binding ShowAllNotesCommand}" ToolTip="All Notes" Margin="0,0,0,10">
                <!-- 2x2 grid: reads as "everything/overview", distinct from the checklist and pencil silhouettes below. -->
                <Viewbox Width="18" Height="18">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="1.5" Canvas.Top="1.5" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1"
                                   Stroke="#333333" StrokeThickness="1.3"/>
                        <Rectangle Canvas.Left="9" Canvas.Top="1.5" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1"
                                   Stroke="#333333" StrokeThickness="1.3"/>
                        <Rectangle Canvas.Left="1.5" Canvas.Top="9" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1"
                                   Stroke="#333333" StrokeThickness="1.3"/>
                        <Rectangle Canvas.Left="9" Canvas.Top="9" Width="5.5" Height="5.5" RadiusX="1" RadiusY="1"
                                   Stroke="#333333" StrokeThickness="1.3"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="TodosNavButton" Style="{StaticResource TodosNavButtonStyle}"
                    Command="{Binding ShowTodosCommand}" ToolTip="Todos" Margin="0,0,0,10">
                <!-- Standalone checklist (no page outline), so the checkbox rows themselves are the whole silhouette. -->
                <Viewbox Width="18" Height="18">
                    <Canvas Width="16" Height="16">
                        <Rectangle Canvas.Left="1.5" Canvas.Top="1.8" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                   Stroke="#333333" StrokeThickness="1.2"/>
                        <Polyline Points="2.1,3.4 2.9,4.2 4.3,2.4" Stroke="#0066CC" StrokeThickness="0.9"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        <Line X1="6.6" Y1="3.5" X2="14.5" Y2="3.5" Stroke="#333333" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Rectangle Canvas.Left="1.5" Canvas.Top="6.3" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                   Stroke="#333333" StrokeThickness="1.2"/>
                        <Line X1="6.6" Y1="8" X2="14.5" Y2="8" Stroke="#333333" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Rectangle Canvas.Left="1.5" Canvas.Top="10.8" Width="3.4" Height="3.4" RadiusX="0.6" RadiusY="0.6"
                                   Stroke="#333333" StrokeThickness="1.2"/>
                        <Line X1="6.6" Y1="12.5" X2="13" Y2="12.5" Stroke="#333333" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="NotesNavButton" Style="{StaticResource NotesNavButtonStyle}"
                    Command="{Binding ShowNotesCommand}" ToolTip="Notes" Margin="0,0,0,10">
                <!-- Pencil: reads as "free-form writing", an elongated diagonal silhouette unlike the grid/checklist above. -->
                <Viewbox Width="18" Height="18">
                    <Canvas Width="16" Height="16">
                        <Canvas Width="16" Height="16" RenderTransformOrigin="0.5,0.5">
                            <Canvas.RenderTransform>
                                <RotateTransform Angle="-45"/>
                            </Canvas.RenderTransform>
                            <Rectangle Canvas.Left="1.5" Canvas.Top="6.3" Width="8.5" Height="3.4" Stroke="#333333" StrokeThickness="1.2"/>
                            <Line X1="9" Y1="6.3" X2="9" Y2="9.7" Stroke="#333333" StrokeThickness="0.9"/>
                            <Polygon Points="10,6.3 14.5,8 10,9.7" Stroke="#333333" StrokeThickness="1.2" StrokeLineJoin="Round"/>
                        </Canvas>
                    </Canvas>
                </Viewbox>
            </Button>

            <Button x:Name="FavoritesNavButton" Style="{StaticResource FavoritesNavButtonStyle}"
                    Command="{Binding ShowFavoritesCommand}" ToolTip="Favorites" Margin="0,0,0,10">
                <TextBlock Text="⭐" FontSize="30"/>
            </Button>

            <Button x:Name="SettingsNavButton" Style="{StaticResource SidebarIconButtonStyle}" ToolTip="Settings">
                <TextBlock Text="⚙️" FontSize="16"/>
            </Button>
        </StackPanel>

        <!-- Trash, pinned to the bottom: a dashed drop target, not a clickable nav icon. It only
             reacts to a note being dragged onto it - it has no Command and never navigates. -->
        <StackPanel Grid.Row="2" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,20">
            <Grid Width="40" Height="40">
                <Rectangle x:Name="TrashDropTarget" Style="{StaticResource TrashDropTargetStyle}"
                           ToolTip="Drag a note here to delete"
                           behaviors:DragDropTargetBehavior.DropCommand="{Binding NotesListViewModel.RequestDeleteNoteCommand}"/>
                <Viewbox Width="18" Height="18" IsHitTestVisible="False">
                    <Canvas Width="16" Height="16">
                        <Line X1="6.5" Y1="2" X2="6.5" Y2="4" Stroke="#333333" StrokeThickness="1.1"/>
                        <Line X1="9.5" Y1="2" X2="9.5" Y2="4" Stroke="#333333" StrokeThickness="1.1"/>
                        <Line X1="6.5" Y1="2" X2="9.5" Y2="2" Stroke="#333333" StrokeThickness="1.1"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Line X1="3" Y1="4" X2="13" Y2="4" Stroke="#333333" StrokeThickness="1.3"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                        <Polygon Points="4,4 12,4 11,14 5,14" Stroke="#333333" StrokeThickness="1.3" StrokeLineJoin="Round"/>
                        <Line X1="7" Y1="6.5" X2="7" Y2="11.5" Stroke="#333333" StrokeThickness="1"/>
                        <Line X1="9" Y1="6.5" X2="9" Y2="11.5" Stroke="#333333" StrokeThickness="1"/>
                    </Canvas>
                </Viewbox>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
