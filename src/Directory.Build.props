<Project>

  <!--
    Central version definition for every project under src/. Bump per the convention
    documented in CONTRIBUTING.md when cutting a release; do not set Version/AssemblyVersion/
    FileVersion in individual csproj files.
  -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
  </PropertyGroup>

</Project>
